# -----------------------------------------------------------------------
#  MAL for Streamlit Secrets – tradingjournalen.
#
#  Dette er BARE en mal (trygg å ha på GitHub). Den EKTE fila heter
#  secrets.toml (uten .example) og skal ALDRI lastes opp – den er allerede
#  lagt i .gitignore.
#
#  LOKALT (på din Mac):
#    1. Kopier denne fila til .streamlit/secrets.toml
#    2. Fyll inn de tre verdiene under.
#
#  PÅ NETT (Streamlit Community Cloud):
#    Appen → Manage app → Settings → Secrets → lim inn de tre linjene der.
# -----------------------------------------------------------------------

# Prosjekt-URL-en fra Supabase (Settings → Data API → Project URL).
SUPABASE_URL = "https://DITT-PROSJEKT.supabase.co"

# service_role-nøkkelen (Settings → API Keys → service_role).
# Hemmelig! Gir full tilgang. Kun her, aldri i koden.
SUPABASE_SERVICE_KEY = "lim-inn-service_role-noekkelen-her"

# Passordet du selv velger for å låse opp journalen i appen.
JOURNAL_PASSORD = "velg-et-passord-du-husker"
